# --- Heavy data (shared through the team drive, not through git) ---
data/raw/**
data/interim/**
data/processed/**
!data/**/
!data/**/.gitkeep
!data/**/README.md
# The LISTS of what was downloaded do go to git (to reproduce and compare); the data do not
!data/raw/**/MANIFEST.csv
!data/raw/**/LISTADO_*.csv
# The CARDS (summaries per site, KB) do go to git; the large intermediates (parquet) go through the drive
!data/processed/*.csv

# Large raster / scientific formats anywhere
*.tif
*.tiff
*.img
*.IMG
*.nc
*.h5
*.hdf
*.jp2
*.zip
*.tar.gz

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/

# --- HTML generated when previewing the .md files with LaTeX ---
docs/**/*.html

# --- Node / frontend ---
node_modules/
.vite/
dist/
build/
.next/

# --- Environment and secrets ---
.env
*.key
credentials*.json

# --- OS / editors ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

# --- Heavy videos of the presentation ---
presentation/**/*.mp4
presentation/**/*.mov
# Slide decks: too large for git (the pitch is 127 MB; GitHub refuses files over 100 MB).
# The pitch is attached to the GitHub release `pitch` instead (see presentation/README.md).
presentation/**/*.pptx
presentation/**/~$*

# --- Local Claude Code config (preview server) ---
.claude/
